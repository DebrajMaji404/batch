<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.eazy</groupId>
    <artifactId>eazy-batch-processor</artifactId>
    <version>1.0.2</version>
    <packaging>jar</packaging>

    <name>Eazy Batch Processor</name>
    <description>Spring Boot Batch Processing Library with Annotation Processor</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <spring-boot.version>4.0.2</spring-boot.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- Imports Spring Boot's managed dependency versions, so test-only
         Spring Batch artifacts (spring-batch-test) automatically align with
         whatever Spring Batch version spring-boot-starter-batch pulls in for
         4.0.2, instead of us having to track and hardcode that version
         separately (this project doesn't use spring-boot-starter-parent). -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring Boot Dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-batch</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <version>${spring-boot.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>

        <!-- Excel Processing -->
        <dependency>
            <groupId>com.github.ozlerhakan</groupId>
            <artifactId>poiji</artifactId>
            <version>4.1.1</version>
        </dependency>

        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.3</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.44</version>
            <scope>provided</scope>
        </dependency>

        <!-- JetBrains Annotations -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>24.0.1</version>
        </dependency>

        <!-- https://mvnrepository.com/artifact/com.github.ben-manes.caffeine/caffeine -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>3.2.3</version>
        </dependency>

        <!-- https://mvnrepository.com/artifact/org.springframework.boot/spring-boot-starter-mail -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>

        <!-- https://mvnrepository.com/artifact/com.opencsv/opencsv -->
        <dependency>
            <groupId>com.opencsv</groupId>
            <artifactId>opencsv</artifactId>
            <version>5.12.0</version>
        </dependency>

        <!-- WebSocket (STOMP) support for live progress + error-report push -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>

        <!-- Test dependencies: JUnit 5, Mockito, AssertJ (via spring-boot-starter-test) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>${spring-boot.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- MetaDataInstanceFactory etc. - Spring Batch's own official test
             utilities for building JobExecution/StepExecution test fixtures
             without hand-rolling domain-object constructors (which are
             version-sensitive - e.g. entity IDs changed from Long to
             primitive long between Spring Batch 5 and 6). Version comes from
             the spring-boot-dependencies BOM imported above. -->
        <dependency>
            <groupId>org.springframework.batch</groupId>
            <artifactId>spring-batch-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Maven Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <encoding>UTF-8</encoding>
                </configuration>
                <executions>
                    <!-- Main sources: this library has no @BatchJob/@BatchExportJob
                         usages of its own. annotationProcessorPaths is scoped to ONLY
                         this execution (not the plugin-level <configuration>, and NOT
                         inherited by default-testCompile below) - setting
                         annotationProcessorPaths at all switches javac from classpath-
                         based processor auto-discovery to ONLY the listed path, so if
                         this were left at the plugin level it would silently exclude
                         our own BatchJobAnnotationProcessor/BatchExportJobAnnotationProcessor
                         (registered via META-INF/services, normally found via the
                         classpath) from test compilation too - which is exactly what
                         happened before this fix: every AnnotationProcessorCodegenTest
                         fixture's generated companion class was missing at test time,
                         because the processors never ran, while everything else still
                         "compiled" fine since an unprocessed @BatchJob annotation isn't
                         a syntax error on its own. -->
                    <execution>
                        <id>default-compile</id>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                    <version>1.18.44</version>
                                </path>
                            </annotationProcessorPaths>
                            <compilerArgs>
                                <arg>-Aprocessor.skip.batchjob=true</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                    <!-- Test sources: deliberately NO annotationProcessorPaths override
                         here, so javac falls back to normal classpath-based processor
                         discovery - this picks up BOTH lombok (provided-scope dependency
                         jar has its own SPI registration) AND our own
                         BatchJobAnnotationProcessor/BatchExportJobAnnotationProcessor
                         (via target/classes' META-INF/services/javax.annotation.processing.Processor,
                         already built by the time testCompile runs), so
                         AnnotationProcessorCodegenTest's fixtures actually get their
                         generated companion classes produced and this catches
                         generated-source bugs (bad imports, wrong constructor
                         signatures, etc.) at test time instead of only in a downstream
                         consumer's build. -->
                    <execution>
                        <id>default-testCompile</id>
                    </execution>
                </executions>
            </plugin>

            <!-- Create sources jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*</include>
                </includes>
            </resource>
        </resources>
    </build>
</project>